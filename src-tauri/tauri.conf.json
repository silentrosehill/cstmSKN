{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cstmSKN",
  "version": "0.1.23",
  "identifier": "com.silentrosehill.cstmskn",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "cstmSKN",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "decorations": true,
        "visible": false,
        "focus": true,
        "minWidth": 1000,
        "minHeight": 700,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/mod-tools"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2REI0NzQ1RjFCMzU3MEMKUldRTVY3UHhSVWZiNXBFV1RFOWdHeUJUT3NxVExRcjdxSll0UjNwRUxkZ1JWRlNpY3FBM08wcnkK",
      "endpoints": [
        "https://github.com/silentrosehill/cstmSKN/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
