{
  "app": {
    "windows": [
      {
        "title": "cstmSKN",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "decorations": true,
        "visible": false,
        "focus": true,
        "minWidth": 1000,
        "minHeight": 700,
        "transparent": false,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": [],
    "resources": {
      "resources/ltk-companion/": "ltk-companion/",
      "resources/windows/THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "resources/windows/dependency-licenses.json": "dependency-licenses.json"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
